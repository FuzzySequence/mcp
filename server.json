{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.FuzzySequence/mcp",
  "title": "Fuzzy Sequence",
  "description": "Manage Fuzzy campaigns, contacts, inbox, and LinkedIn drafts from your assistant with OAuth.",
  "version": "0.2.0",
  "websiteUrl": "https://github.com/FuzzySequence/mcp",
  "repository": { "url": "https://github.com/FuzzySequence/mcp", "source": "github" },
  "remotes": [
    { "type": "streamable-http", "url": "https://app-api.fuzzysequence.com/public-mcp" }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "documentationUrl": "https://github.com/FuzzySequence/mcp#connecting",
      "authentication": { "type": "oauth", "pkce": "S256", "registration": "dcr" },
      "defaultScopes": ["read", "draft", "campaign_draft", "credit_spend", "campaign_launch", "destructive", "billing", "offline_access"]
    }
  }
}
